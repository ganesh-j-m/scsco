# Neon PostgreSQL (use pooled URL for DATABASE_URL, direct URL for migrations)
DATABASE_URL="postgresql://USER:PASSWORD@HOST-pooler.neon.tech/scsco?sslmode=require"
DIRECT_URL="postgresql://USER:PASSWORD@HOST.neon.tech/scsco?sslmode=require"

# Long random string (e.g. openssl rand -base64 48)
AUTH_SECRET="change-me"
AUTH_COOKIE_NAME="scsco_session"
AUTH_TTL_HOURS="12"

PORT="4000"
CLIENT_ORIGIN="http://localhost:5173"
NODE_ENV="development"

# Uploads (local disk by default)
UPLOAD_DIR="./uploads"
UPLOAD_MAX_MB="5"

# Seed super admin (change immediately after first login)
SEED_ADMIN_PASSWORD="ChangeMe@123"

# Production only
# CLIENT_ORIGIN must be the exact public site URL, e.g. https://scsco.vercel.app (no trailing slash)
# TRUST_PROXY: 1 when the browser talks to this server through one proxy, 2 when Vercel proxies /api to a host like Render
TRUST_PROXY="1"

# Private documents (assignments, study material, form attachments). Use a persistent disk in production.
PRIVATE_UPLOAD_DIR="./private-uploads"
PRIVATE_UPLOAD_MAX_MB="10"
